# ---------------------------------------------------------------------------
# LTR Growth configuration. Copy to .env.local for local development.
# Variables without NEXT_PUBLIC_ are server-only and must never be exposed.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in: enable the Google provider in Supabase Auth first, then set to true
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# AI (OpenAI-compatible). Optional OPENAI_BASE_URL for compatible providers.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Website analysis (optional; built-in SSRF-safe fetcher is used without Firecrawl)
FIRECRAWL_API_KEY=
PAGESPEED_API_KEY=

# Payments (Phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Phase 5)
RESEND_API_KEY=
EMAIL_FROM=
AGENCY_NOTIFICATION_EMAIL=
